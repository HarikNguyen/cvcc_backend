# ── AI Services ───────────────────────────────────────────────────────────────
# Google Gemini API (script generation via LLM)
GEMINI_API_KEY=AIza_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Cloud TTS (voiceover generation)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account.json

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ── Paths ─────────────────────────────────────────────────────────────────────
ARTIFACTS_DIR=artifacts
TMP_DIR=tmp_manim_scenes

# ── Pipeline config ───────────────────────────────────────────────────────────
GEMINI_MODEL=gemini-3.8-flash
GEN_SCRIPT_MAX_RETRIES=3
GEN_CODE_MAX_RETRIES=3
MANIM_RENDER_TIMEOUT_S=120
